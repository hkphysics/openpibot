# Multi-stage build: separate build and runtime environments
FROM node:24-bookworm-slim AS builder

WORKDIR /app

# Set production environment to minimize dependency tree
ENV NODE_ENV=production

# Install minimal system dependencies required at build time, then clean apt cache in same layer
RUN --mount=type=tmpfs,destination=/tmp \
    --mount=type=tmpfs,destination=/var/tmp \
    --mount=type=cache,target=/var/cache,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      python3 \
      python3-pip \
      git \
      ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy package files and install dependencies (cached unless package*.json changes)
COPY package*.json ./
RUN npm ci --omit=dev --no-audit --no-fund && \
    npm cache clean --force

# Copy application source
COPY src ./src

# Runtime stage - minimal image
FROM node:24-bookworm-slim

WORKDIR /app

# Production environment and app config
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=11435 \
    PI_WORKSPACE=/workspace \
    PI_TOOLS=read,bash,edit,write,grep,find,ls \
    PI_SHOW_PROGRESS=true \
    HOME=/home/node

# Copy installed dependencies and source from builder stage
COPY --from=builder --chown=pibot:pibot /app/node_modules ./node_modules
COPY --from=builder --chown=pibot:pibot /app/src ./src

# Run as non-root user for security
USER node

EXPOSE 11435

CMD ["node", "src/server.js"]
