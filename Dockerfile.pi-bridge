# Multi-stage build: separate build and runtime environments
FROM node:24-alpine AS builder

WORKDIR /app

# Set production environment to minimize dependency tree
ENV NODE_ENV=production

# Install minimal system dependencies required at build time
RUN apk add --no-cache ca-certificates python3 py3-pip git

# Copy package files and install dependencies (cached unless package*.json changes)
COPY package*.json ./
RUN npm ci --omit=dev --no-audit --no-fund && \
    npm cache clean --force

# Copy application source
COPY src ./src

# Runtime stage - minimal image
FROM node:24-alpine

WORKDIR /app

# Production environment and app config
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=11435 \
    PI_WORKSPACE=/workspace \
    PI_TOOLS=read,bash,edit,write,grep,find,ls \
    PI_SHOW_PROGRESS=true \
    HOME=/home/node

# Install runtime-only dependencies
RUN apk add --no-cache ca-certificates

# Copy installed dependencies and source from builder stage
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/src ./src

# Run as non-root user for security
RUN mkdir -p /workspace && chmod 755 /workspace

USER node

EXPOSE 11435

CMD ["node", "src/server.js"]
